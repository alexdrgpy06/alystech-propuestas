# Admin panel (/admin) — basic auth
ADMIN_USER=admin
ADMIN_PASS=cambiar-esto

# Email destino de notificaciones (aceptar/rechazar/consulta)
NOTIFY_EMAIL=alexdrg06@gmail.com

# SMTP saliente
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Set to 'false' only in staging if the Stalwart instance uses a self-signed cert.
# Production must use a trusted cert and keep this 'true' (the default).
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=propuestas@alystechpy.online
